{
  "name": "safebrowse-sdk",
  "private": true,
  "version": "0.1.4",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobKang1234/safebrowse-sdk.git"
  },
  "homepage": "https://github.com/RobKang1234/safebrowse-sdk#readme",
  "bugs": {
    "url": "https://github.com/RobKang1234/safebrowse-sdk/issues"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "node scripts/run-pnpm.mjs -r --if-present build && tsc -p tsconfig.scripts.json",
    "changeset": "changeset",
    "typecheck": "node scripts/run-pnpm.mjs build",
    "test:ts": "vitest run",
    "test:py": "node scripts/run-python-module.mjs -m unittest discover -s python/safebrowse_client/tests -p test_*.py",
    "test": "node scripts/run-pnpm.mjs test:ts && node scripts/run-pnpm.mjs test:py",
    "check": "node scripts/run-pnpm.mjs typecheck && node scripts/run-pnpm.mjs test",
    "perf:smoke": "tsx packages/core/src/perf-smoke.ts",
    "perf:daemon": "node scripts/ci/benchmark-daemon-routes.mjs",
    "perf:daemon:gate": "node scripts/ci/benchmark-daemon-routes.mjs --assert-thresholds",
    "kb:bundle": "tsx packages/kb-tools/src/cli.ts build-bundle",
    "kb:verify": "tsx packages/kb-tools/src/cli.ts verify-bundle",
    "demo:compare": "node scripts/run-pnpm.mjs build && node scripts-dist/threat-demo/run-auditor-suite-v6.js",
    "demo:serve-live": "node scripts/run-pnpm.mjs build && node scripts-dist/threat-demo/serve-live.js",
    "demo:watch-live": "node scripts/run-pnpm.mjs build && node scripts-dist/threat-demo/watch-live-v6.js",
    "auditor:review:v6": "node scripts/run-pnpm.mjs build && node scripts-dist/threat-demo/run-auditor-suite-v6.js",
    "auditor:parity:v6": "node scripts/ci/run-wrapper-parity-v6.mjs",
    "auditor:live-smoke:v6": "node scripts/run-pnpm.mjs build && node scripts/ci/smoke-watch-live-v6.mjs",
    "release:sync-version": "node scripts/release/sync-version.mjs",
    "release:next-version": "node scripts/release/next-version.mjs",
    "release:update-manifest": "node scripts/release/update-release-manifest.mjs",
    "release:version": "changeset version && node scripts/release/sync-version.mjs",
    "release:build:python": "node scripts/release/build-python-artifacts.mjs",
    "release:check:python": "node scripts/release/check-python-artifacts.mjs",
    "release:audit": "node scripts/release/audit-public-artifacts.mjs",
    "release:smoke:artifacts": "node scripts/release/smoke-public-artifacts.mjs",
    "release:smoke:docker": "node scripts/release/docker-smoke.mjs",
    "release:ready:auto": "node scripts/automation/run-release-readiness.mjs",
    "release:check": "node scripts/run-pnpm.mjs build && node scripts/run-pnpm.mjs test && node scripts/run-pnpm.mjs release:build:python && node scripts/run-pnpm.mjs release:check:python && node scripts/run-pnpm.mjs release:audit && node scripts/run-pnpm.mjs release:smoke:artifacts && node scripts/run-pnpm.mjs release:smoke:docker",
    "release:ready": "node scripts/run-pnpm.mjs build && node scripts/run-pnpm.mjs test && node scripts/run-pnpm.mjs perf:smoke && node scripts/run-pnpm.mjs perf:daemon:gate && node scripts/run-pnpm.mjs release:build:python && node scripts/run-pnpm.mjs release:check:python && node scripts/run-pnpm.mjs release:audit && node scripts/run-pnpm.mjs release:smoke:artifacts && node scripts/run-pnpm.mjs release:smoke:docker"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
