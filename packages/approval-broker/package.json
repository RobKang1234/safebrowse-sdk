{
  "name": "@safebrowse/approval-broker",
  "private": true,
  "version": "0.1.3",
  "description": "Internal approval-signing broker for SafeBrowse secure_v6 flows",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "safebrowse-approval-broker": "dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@safebrowse/core": "workspace:*"
  }
}
