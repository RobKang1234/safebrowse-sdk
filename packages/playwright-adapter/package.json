{
  "name": "@safebrowse/playwright-adapter",
  "version": "0.1.5",
  "description": "Playwright reference adapter for the SafeBrowse runtime",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobKang1234/safebrowse-sdk.git",
    "directory": "packages/playwright-adapter"
  },
  "homepage": "https://github.com/RobKang1234/safebrowse-sdk#readme",
  "bugs": {
    "url": "https://github.com/RobKang1234/safebrowse-sdk/issues"
  },
  "keywords": [
    "agent-security",
    "browser-agents",
    "playwright",
    "reference-adapter",
    "safebrowse"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@safebrowse/core": "workspace:*"
  },
  "peerDependencies": {
    "playwright-core": ">=1.49.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "sideEffects": false
}
